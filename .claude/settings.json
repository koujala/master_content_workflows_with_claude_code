{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/build_index.py\" --hook",
            "timeout": 30,
            "statusMessage": "Rebuilding posts index..."
          }
        ]
      }
    ]
  }
}
